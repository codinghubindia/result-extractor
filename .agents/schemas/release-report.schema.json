{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleaseReport",
  "type": "object",
  "required": [
    "releaseId",
    "version",
    "status",
    "buildArtifacts",
    "changelog",
    "signOff"
  ],
  "properties": {
    "releaseId": { "type": "string" },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["ready", "released", "aborted"] },
    "buildArtifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changelog": {
      "type": "array",
      "items": { "type": "string" }
    },
    "signOff": {
      "type": "object",
      "required": ["qaApproved", "securityApproved", "integrationApproved"],
      "properties": {
        "qaApproved": { "type": "boolean" },
        "securityApproved": { "type": "boolean" },
        "integrationApproved": { "type": "boolean" }
      }
    }
  }
}
