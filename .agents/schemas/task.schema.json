{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskContract",
  "type": "object",
  "required": [
    "taskId",
    "owner",
    "goal",
    "status",
    "inputs",
    "outputs",
    "dependencies",
    "filesOrAreaOwned",
    "acceptanceCriteria"
  ],
  "properties": {
    "taskId": { "type": "string" },
    "parentTaskId": { "type": ["string", "null"] },
    "owner": { "type": "string" },
    "goal": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "in-progress", "completed", "failed", "blocked"]
    },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "filesOrAreaOwned": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
