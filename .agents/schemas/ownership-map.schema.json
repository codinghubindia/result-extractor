{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OwnershipMap",
  "type": "object",
  "required": ["version", "directories", "files"],
  "properties": {
    "version": { "type": "string" },
    "directories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "ownerAgent", "description"],
        "properties": {
          "path": { "type": "string" },
          "ownerAgent": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "ownerAgent"],
        "properties": {
          "path": { "type": "string" },
          "ownerAgent": { "type": "string" },
          "shared": { "type": "boolean" }
        }
      }
    }
  }
}
