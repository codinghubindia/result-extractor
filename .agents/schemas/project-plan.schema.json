{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectPlan",
  "type": "object",
  "required": [
    "projectId",
    "projectName",
    "version",
    "status",
    "milestones",
    "tasks"
  ],
  "properties": {
    "projectId": { "type": "string" },
    "projectName": { "type": "string" },
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "planning", "in-progress", "qa", "released", "blocked"]
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["milestoneId", "title", "status"],
        "properties": {
          "milestoneId": { "type": "string" },
          "title": { "type": "string" },
          "targetDate": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "active", "completed"] },
          "deliverables": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "task.schema.json" }
    }
  }
}
