{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiContract",
  "type": "object",
  "required": ["apiName", "version", "endpoints"],
  "properties": {
    "apiName": { "type": "string" },
    "version": { "type": "string" },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "method", "description", "request", "response"],
        "properties": {
          "path": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "description": { "type": "string" },
          "request": { "type": "object" },
          "response": { "type": "object" }
        }
      }
    }
  }
}
