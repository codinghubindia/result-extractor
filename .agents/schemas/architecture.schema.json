{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArchitectureContract",
  "type": "object",
  "required": [
    "systemName",
    "version",
    "techStack",
    "serviceBoundaries",
    "modules",
    "contracts"
  ],
  "properties": {
    "systemName": { "type": "string" },
    "version": { "type": "string" },
    "techStack": {
      "type": "object",
      "properties": {
        "backend": { "type": "string" },
        "frontend": { "type": "string" },
        "database": { "type": "string" },
        "runtime": { "type": "string" }
      }
    },
    "serviceBoundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service", "owner", "responsibility"],
        "properties": {
          "service": { "type": "string" },
          "owner": { "type": "string" },
          "responsibility": { "type": "string" }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "path", "owner"],
        "properties": {
          "module": { "type": "string" },
          "path": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    },
    "contracts": {
      "type": "object",
      "properties": {
        "apiSchema": { "type": "string" },
        "dataSchema": { "type": "string" }
      }
    }
  }
}
